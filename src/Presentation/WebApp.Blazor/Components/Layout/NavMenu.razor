@using Application.Common.Interfaces
@using Application.UseCases.Rosters
@using Infrastructure.Data.Identity

@inject GetPendingShiftSwapsUseCase GetPendingShiftSwapsUseCase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IShiftSwapNotificationService ShiftSwapNotificationService
@inject NavigationManager NavigationManager
@implements IDisposable

<aside class="nav-shell" aria-label="Navegação principal">
    <div class="nav-shell__brand">
        <a class="nav-shell__brand-link" href="/">
            <span class="nav-shell__logo-mark" aria-hidden="true">5x2</span>
            <span class="nav-shell__brand-text">
                <strong>Virada 5x2</strong>
                <small>Gestão de Escalas</small>
            </span>
        </a>
    </div>

    <AuthorizeView>
        <Authorized>
            <nav class="nav-shell__menu">
                <span class="nav-shell__section-label">Operação</span>

                <NavLink class="nav-shell__link" href="/" Match="NavLinkMatch.All">
                    Visão Geral
                </NavLink>

                @if (context.User.IsInRole(ApplicationRoles.Owner) || context.User.IsInRole(ApplicationRoles.Manager))
                {
                    <NavLink class="nav-shell__link" href="/onboarding">
                        Onboarding da Casa
                    </NavLink>
                    <NavLink class="nav-shell__link" href="/settings/company">
                        Configurações da Casa
                    </NavLink>
                    <NavLink class="nav-shell__link" href="/demand">
                        Demanda &amp; Mapa de Calor
                    </NavLink>
                    <NavLink class="nav-shell__link" href="/financial">
                        Simulador Financeiro
                    </NavLink>
                    <NavLink class="nav-shell__link" href="/employees">
                        Equipe &amp; Polivalência
                    </NavLink>
                    <NavLink class="nav-shell__link" href="/roster">
                        <span>Painel da Escala 5x2</span>
                        @if (_pendingManagerSwaps > 0)
                        {
                            <span class="nav-shell__badge" data-testid="nav-pending-swaps-badge">@_pendingManagerSwaps</span>
                        }
                    </NavLink>
                }
            </nav>

            <div class="nav-shell__footer">
                <div class="nav-shell__user">
                    <span class="nav-shell__user-name">@(context.User.FindFirst("full_name")?.Value ?? context.User.Identity?.Name ?? "Usuário")</span>
                    <span class="nav-shell__user-role">@ResolvePrimaryRoleLabel(context.User)</span>
                </div>

                <form action="/Account/Logout" method="post" class="nav-shell__logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/Account/Login" />
                    <button type="submit" class="nav-shell__logout-btn">Sair</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <nav class="nav-shell__menu">
                <span class="nav-shell__section-label">Acesso</span>
                <NavLink class="nav-shell__link" href="/Account/Login">
                    Entrar na Plataforma
                </NavLink>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</aside>

@code {
    private int _pendingManagerSwaps;
    private Guid _currentTenantId;
    private bool _isManagerOrOwner;
    private bool _disposed;

    protected override void OnInitialized()
    {
        ShiftSwapNotificationService.OnTenantSwapsChanged += HandleTenantSwapsChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (!user.IsInRole(ApplicationRoles.Owner) && !user.IsInRole(ApplicationRoles.Manager))
        {
            return;
        }

        _isManagerOrOwner = true;
        var tenantClaim = user.FindFirst(TenantClaimTypes.TenantId)?.Value;
        _ = Guid.TryParse(tenantClaim, out _currentTenantId);

        await RefreshPendingSwapsAsync();
    }

    private void HandleTenantSwapsChanged(Guid tenantId)
    {
        if (_disposed || !_isManagerOrOwner || _currentTenantId == Guid.Empty || tenantId != _currentTenantId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await RefreshPendingSwapsAsync();
            StateHasChanged();
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed || !_isManagerOrOwner)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await RefreshPendingSwapsAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshPendingSwapsAsync()
    {
        var result = await GetPendingShiftSwapsUseCase.ExecuteAsync(
            new GetPendingShiftSwapsCommand(IncludeCltEvaluation: false));
        if (result.IsSuccess)
        {
            _pendingManagerSwaps = result.Value.PendingManagerApprovalCount;
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        ShiftSwapNotificationService.OnTenantSwapsChanged -= HandleTenantSwapsChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private static string ResolvePrimaryRoleLabel(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(ApplicationRoles.Owner))
        {
            return "Proprietário";
        }

        if (user.IsInRole(ApplicationRoles.Manager))
        {
            return "Gestor";
        }

        if (user.IsInRole(ApplicationRoles.Employee))
        {
            return "Colaborador";
        }

        return "Autenticado";
    }
}

