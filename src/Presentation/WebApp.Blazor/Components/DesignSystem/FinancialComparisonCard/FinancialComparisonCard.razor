@using System.Globalization
@using Application.DTOs.Financial
@using WebApp.Blazor.Components.DesignSystem.AppBadge
@using WebApp.Blazor.Components.DesignSystem.AppButton
@using WebApp.Blazor.Components.DesignSystem.AppCard
@using WebApp.Blazor.Helpers

<AppCard Title="Simulador de Viabilidade Financeira"
         Subtitle="@(Simulation is null ? null : $"{Simulation.CompanyName} — {Simulation.HeadcountUsed} colaboradores")"
         Elevation="AppCardElevation.Medium"
         FooterContent="@(Simulation is not null && ShowPrimaryCta ? RenderFooter() : null)"
         @attributes="AdditionalAttributes">
    <HeaderContent>
        @if (Simulation is not null)
        {
            <AppBadge Variant="@ResolveSavingsBadgeVariant()"
                      Text="@($"Economia: {DesignSystemDisplayHelper.FormatDecimal(Simulation.SavingsPercentage, 1)}%")" />
        }
    </HeaderContent>

    <ChildContent>
        @if (Simulation is null)
        {
            <div class="financial-card__empty">
                Nenhuma simulação financeira executada até o momento.
            </div>
        }
        else
        {
            <div class="financial-card__kpis">
                <div class="financial-card__kpi financial-card__kpi--highlight">
                    <span class="financial-card__kpi-label">Economia mensal estimada</span>
                    <strong class="financial-card__kpi-value financial-card__savings-monthly">
                        @DesignSystemDisplayHelper.FormatCurrency(Simulation.MonthlySavings)
                    </strong>
                </div>
                <div class="financial-card__kpi financial-card__kpi--highlight">
                    <span class="financial-card__kpi-label">Economia anual projetada</span>
                    <strong class="financial-card__kpi-value financial-card__savings-annual">
                        @DesignSystemDisplayHelper.FormatCurrency(Simulation.AnnualSavings)
                    </strong>
                </div>
                <div class="financial-card__kpi">
                    <span class="financial-card__kpi-label">Horas extras evitadas / mês</span>
                    <strong class="financial-card__kpi-value">
                        @($"{DesignSystemDisplayHelper.FormatDecimal(Simulation.OvertimeHoursSavedPerMonth, 1)} h")
                    </strong>
                </div>
            </div>

            <section class="financial-card__visual-comparison" aria-label="Comparativo visual de custo mensal 6x1 versus 5x2">
                @{
                    var maxMonthlyCost = ResolveMaxMonthlyCost();
                }
                @RenderComparisonRow(
                    "Cenário Atual 6x1",
                    Simulation.CurrentScenario6x1.TotalMonthlyCost,
                    maxMonthlyCost,
                    "financial-card__comparison-bar--current",
                    "Custo mensal cenário 6x1")

                @RenderComparisonRow(
                    "Cenário Otimizado 5x2",
                    Simulation.OptimizedScenario5x2.TotalMonthlyCost,
                    maxMonthlyCost,
                    "financial-card__comparison-bar--optimized",
                    "Custo mensal cenário 5x2")
            </section>

            @if (Simulation.HasDemandMatrix && Simulation.EstimatedIdlePayrollExposure6x1 is not null)
            {
                <div class="financial-card__idle-exposure">
                    <span>Exposição estimada com folha ociosa no modelo 6x1 (@($"{DesignSystemDisplayHelper.FormatDecimal(Simulation.DemandIdlenessPercentage ?? 0m, 1)}% de ociosidade")):</span>
                    <strong>@DesignSystemDisplayHelper.FormatCurrency(Simulation.EstimatedIdlePayrollExposure6x1.Value) / mês</strong>
                </div>
            }

            @if (ShowDetailedBreakdown)
            {
                <div class="financial-card__scenarios">
                    @RenderScenarioBreakdown(
                        "Cenário Atual 6x1",
                        "Modelo Atual",
                        AppBadgeVariant.Warning,
                        isOptimized: false,
                        Simulation.CurrentScenario6x1)

                    @RenderScenarioBreakdown(
                        "Cenário Otimizado 5x2",
                        "Recomendado",
                        AppBadgeVariant.Success,
                        isOptimized: true,
                        Simulation.OptimizedScenario5x2)
                </div>
            }

            @if (Simulation.Warnings.Count > 0)
            {
                <ul class="financial-card__warnings">
                    @foreach (var warning in Simulation.Warnings)
                    {
                        <li class="financial-card__warning-item">@warning</li>
                    }
                </ul>
            }
        }
    </ChildContent>
</AppCard>

@code {
    [Parameter]
    public FinancialImpactSimulationDto? Simulation { get; set; }

    [Parameter]
    public bool ShowDetailedBreakdown { get; set; } = true;

    [Parameter]
    public string PrimaryCtaText { get; set; } = "Gerar Escala 5x2";

    [Parameter]
    public bool ShowPrimaryCta { get; set; }

    [Parameter]
    public bool PrimaryCtaLoading { get; set; }

    [Parameter]
    public bool PrimaryCtaDisabled { get; set; }

    [Parameter]
    public EventCallback OnPrimaryCtaClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private RenderFragment RenderFooter() => __builder =>
    {
        <AppButton Variant="AppButtonVariant.Primary"
                   Loading="PrimaryCtaLoading"
                   Disabled="PrimaryCtaDisabled"
                   OnClick="@(_ => OnPrimaryCtaClick.InvokeAsync())">
            @PrimaryCtaText
        </AppButton>
    };

    private RenderFragment RenderComparisonRow(
        string label,
        decimal monthlyCost,
        decimal maxMonthlyCost,
        string barModifierClass,
        string ariaLabel) => __builder =>
    {
        <div class="financial-card__comparison-row">
            <div class="financial-card__comparison-meta">
                <span class="financial-card__comparison-label">@label</span>
                <strong class="financial-card__comparison-amount">
                    @DesignSystemDisplayHelper.FormatCurrency(monthlyCost)
                </strong>
            </div>
            <progress class="@($"financial-card__comparison-bar {barModifierClass}")"
                      max="@FormatProgressNumber(maxMonthlyCost)"
                      value="@FormatProgressNumber(monthlyCost)"
                      aria-label="@ariaLabel">
            </progress>
        </div>
    };

    private RenderFragment RenderScenarioBreakdown(
        string title,
        string badgeText,
        AppBadgeVariant badgeVariant,
        bool isOptimized,
        ScenarioFinancialBreakdownDto scenario) => __builder =>
    {
        <section class="@(isOptimized ? "financial-card__scenario financial-card__scenario--optimized" : "financial-card__scenario financial-card__scenario--current")">
            <header class="financial-card__scenario-header">
                <h4 class="financial-card__scenario-title">@title</h4>
                <AppBadge Variant="badgeVariant" Text="@badgeText" />
            </header>
            <dl class="financial-card__metrics">
                <div class="financial-card__metric-row">
                    <dt>Folha base + encargos</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.MonthlyBasePayroll + scenario.MonthlyEmployerChargesOnBase)</dd>
                </div>
                <div class="financial-card__metric-row">
                    <dt>Horas extras totais / mês</dt>
                    <dd>@($"{DesignSystemDisplayHelper.FormatDecimal(scenario.TotalMonthlyOvertimeHours, 1)} h")</dd>
                </div>
                <div class="financial-card__metric-row">
                    <dt>Horas extras + DSR + encargos</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.MonthlyOvertimeTotalCost)</dd>
                </div>
                <div class="financial-card__metric-row">
                    <dt>Custo mensal de turnover</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.MonthlyTurnoverCost)</dd>
                </div>
                <div class="financial-card__metric-row">
                    <dt>Provisão passivo trabalhista</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.MonthlyLaborLiabilityProvision)</dd>
                </div>
                <div class="financial-card__metric-row financial-card__metric-row--total">
                    <dt>Custo total mensal</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.TotalMonthlyCost)</dd>
                </div>
                <div class="financial-card__metric-row">
                    <dt>Custo total anual</dt>
                    <dd>@DesignSystemDisplayHelper.FormatCurrency(scenario.AnnualTotalCost)</dd>
                </div>
            </dl>
        </section>
    };

    private AppBadgeVariant ResolveSavingsBadgeVariant()
    {
        if (Simulation is null || Simulation.MonthlySavings == 0m)
        {
            return AppBadgeVariant.Neutral;
        }

        return Simulation.MonthlySavings > 0m
            ? AppBadgeVariant.Success
            : AppBadgeVariant.Warning;
    }

    private decimal ResolveMaxMonthlyCost()
    {
        if (Simulation is null)
        {
            return 1m;
        }

        var max = Math.Max(Simulation.CurrentScenario6x1.TotalMonthlyCost, Simulation.OptimizedScenario5x2.TotalMonthlyCost);
        return max > 0m ? max : 1m;
    }

    private static string FormatProgressNumber(decimal value) =>
        Math.Max(0m, value).ToString("0.##", CultureInfo.InvariantCulture);
}
