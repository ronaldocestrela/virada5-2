@using Microsoft.AspNetCore.Components.Web

@if (IsOpen)
{
    <div class="app-modal__backdrop"
         tabindex="-1"
         @onclick="HandleBackdropClickAsync"
         @onkeydown="HandleKeyDownAsync">
        <div class="@BuildDialogCssClass()"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@TitleId"
             @onclick:stopPropagation="true"
             @attributes="AdditionalAttributes">
            <header class="app-modal__header">
                <h2 id="@TitleId" class="app-modal__title">@Title</h2>
                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="app-modal__close"
                            aria-label="@CloseButtonAriaLabel"
                            @onclick="CloseAsync">
                        ×
                    </button>
                }
            </header>

            <div class="app-modal__body">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <footer class="app-modal__footer">
                    @FooterContent
                </footer>
            }
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"app-modal-title-{Guid.NewGuid():N}";

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public AppModalSize Size { get; set; } = AppModalSize.Medium;

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public string CloseButtonAriaLabel { get; set; } = "Fechar modal";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => _titleId;

    private string BuildDialogCssClass()
    {
        var sizeClass = Size switch
        {
            AppModalSize.Small => "app-modal__dialog--sm",
            AppModalSize.Medium => "app-modal__dialog--md",
            AppModalSize.Large => "app-modal__dialog--lg",
            _ => "app-modal__dialog--md"
        };

        return $"app-modal__dialog {sizeClass}";
    }

    private Task HandleBackdropClickAsync() =>
        CloseOnBackdropClick ? CloseAsync() : Task.CompletedTask;

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        CloseOnEscape && args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task CloseAsync()
    {
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(false);
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
