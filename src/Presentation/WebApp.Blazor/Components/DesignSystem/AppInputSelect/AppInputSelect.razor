@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Blazor.Helpers
@typeparam TValue
@implements IDisposable

<div class="app-field">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="app-field__label" for="@ResolvedId">
            @Label
            @if (Required)
            {
                <span class="app-field__required" aria-hidden="true">*</span>
            }
        </label>
    }

    <select id="@ResolvedId"
            class="@BuildSelectClass()"
            value="@FormatValue(Value)"
            required="@Required"
            disabled="@Disabled"
            aria-invalid="@(HasError ? "true" : null)"
            aria-describedby="@BuildDescribedBy()"
            @onchange="HandleChangeAsync"
            @attributes="AdditionalAttributes">
        @if (!string.IsNullOrWhiteSpace(PlaceholderOption))
        {
            <option value="">@PlaceholderOption</option>
        }

        @foreach (var option in Options)
        {
            <option value="@FormatValue(option.Value)" disabled="@option.Disabled">
                @option.Label
            </option>
        }
    </select>

    @if (HasError)
    {
        <p id="@ErrorId" class="app-field__error" role="alert">@EffectiveErrorMessage</p>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p id="@HelperId" class="app-field__helper">@HelperText</p>
    }
</div>

@code {
    private readonly string _fallbackId = $"app-select-{Guid.NewGuid():N}";
    private EditContext? _subscribedEditContext;
    private FieldIdentifier? _fieldIdentifier;

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter]
    public IReadOnlyList<SelectOption<TValue>> Options { get; set; } = [];

    [Parameter]
    public string? PlaceholderOption { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolvedId => string.IsNullOrWhiteSpace(Id) ? _fallbackId : Id;
    private string HelperId => $"{ResolvedId}-helper";
    private string ErrorId => $"{ResolvedId}-error";
    private string? EffectiveErrorMessage => FieldValidationHelper.ResolveErrorMessage(ErrorMessage, EditContext, _fieldIdentifier);
    private bool HasError => !string.IsNullOrWhiteSpace(EffectiveErrorMessage);

    protected override void OnParametersSet()
    {
        _fieldIdentifier = FieldValidationHelper.ResolveFieldIdentifier(EditContext, ValueExpression);
        FieldValidationHelper.SyncValidationSubscription(ref _subscribedEditContext, EditContext, HandleValidationStateChanged);
    }

    private string BuildSelectClass() =>
        HasError ? "app-field__control app-field__control--error" : "app-field__control";

    private string? BuildDescribedBy()
    {
        if (HasError)
        {
            return ErrorId;
        }

        return !string.IsNullOrWhiteSpace(HelperText) ? HelperId : null;
    }

    private static string FormatValue(TValue? value) =>
        value is null ? string.Empty : Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty;

    private async Task HandleChangeAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (string.IsNullOrEmpty(raw))
        {
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(default);
            }

            FieldValidationHelper.NotifyFieldChanged(EditContext, _fieldIdentifier);
            return;
        }

        if (BindConverter.TryConvertTo<TValue>(raw, CultureInfo.InvariantCulture, out var parsed))
        {
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(parsed);
            }

            FieldValidationHelper.NotifyFieldChanged(EditContext, _fieldIdentifier);
        }
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribedEditContext is not null)
        {
            _subscribedEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }
}
