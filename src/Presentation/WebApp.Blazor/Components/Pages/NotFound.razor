@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada — Virada 5x2</PageTitle>

<AppCard Title="Página não encontrada"
         Subtitle="O endereço solicitado não existe ou foi movido."
         Border="AppCardBorder.Warning">
    <HeaderContent>
        <AppBadge Variant="AppBadgeVariant.Warning" Text="Erro 404" Dot="true" />
    </HeaderContent>
    <ChildContent>
        <p>Verifique se o link está correto ou retorne para a página inicial da Virada 5x2.</p>
    </ChildContent>
    <FooterContent>
        <AppButton Href="/" Variant="AppButtonVariant.Primary">Voltar para o início</AppButton>
    </FooterContent>
</AppCard>
