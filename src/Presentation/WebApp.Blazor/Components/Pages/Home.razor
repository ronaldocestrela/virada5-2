@page "/"
@rendermode InteractiveServer
@using Application.Common.Interfaces
@using Application.DTOs.Companies
@using Application.DTOs.Rosters
@using Application.UseCases.Companies
@using Application.UseCases.Rosters
@using Domain.Common
@using Infrastructure.Data.Identity
@using Microsoft.Extensions.DependencyInjection
@using WebApp.Blazor.Helpers
@using WebApp.Blazor.Services

@inject GetCurrentCompanySettingsUseCase GetCurrentCompanySettingsUseCase
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IShiftSwapNotificationService ShiftSwapNotificationService
@implements IDisposable

<PageTitle>Virada 5x2 | Transição Inteligente 6x1 para 5x2</PageTitle>

<div class="landing-page" data-testid="landing-page">
    <AuthorizeView>
        <Authorized>
            <!-- Painel Operacional para Usuários Autenticados -->
            <section class="landing-dashboard" aria-label="Painel de Controle Operacional">
                @if (context.User.IsInRole(ApplicationRoles.Owner) || context.User.IsInRole(ApplicationRoles.Manager))
                {
                    @if (_companySettings is not null)
                    {
                        <div class="landing-dashboard__header">
                            <div>
                                <span class="landing-section-tag">Painel Operacional</span>
                                <h2 class="landing-dashboard__title">Visão Geral da Casa</h2>
                            </div>
                            <AppBadge Variant="AppBadgeVariant.Success" Text="Operação Ativa" Dot="true" />
                        </div>

                        <div class="home-page__metrics-grid">
                            <MetricTile Label="Prazo Legal"
                                        Value="16/12/2026"
                                        Description="Duas folgas semanais obrigatórias por lei"
                                        Stripe="MetricTile.MetricTileStripe.Orange" />

                            <MetricTile Label="Modelo Operacional"
                                        Value="@DesignSystemDisplayHelper.FormatScheduleModel(_companySettings.ScheduleModel)"
                                        Description="@($"{_companySettings.OpeningTime:HH:mm} às {_companySettings.ClosingTime:HH:mm}")"
                                        Stripe="MetricTile.MetricTileStripe.Navy" />

                            <MetricTile Label="Trocas Pendentes"
                                        Value="@_pendingManagerSwaps.ToString()"
                                        Unit="solicitações"
                                        Description="Trocas de turno confirmadas pela equipe"
                                        Stripe="@(_pendingManagerSwaps > 0 ? MetricTile.MetricTileStripe.Alert : MetricTile.MetricTileStripe.Green)" />

                            <MetricTile Label="Conformidade CLT"
                                        Value="100%"
                                        Description="11h de descanso interjornada garantidas"
                                        Stripe="MetricTile.MetricTileStripe.Green" />
                        </div>

                        <AppCard Title="@_companySettings.Name"
                                 Subtitle="@DesignSystemDisplayHelper.FormatBusinessType(_companySettings.BusinessType)">
                            <HeaderContent>
                                <AppBadge Variant="AppBadgeVariant.Success" Text="Casa configurada" Dot="true" />
                            </HeaderContent>
                            <ChildContent>
                                <dl class="home-page__summary">
                                    <div>
                                        <dt>Funcionamento</dt>
                                        <dd>
                                            @_companySettings.OpeningTime.ToString("HH:mm") às @_companySettings.ClosingTime.ToString("HH:mm")
                                            @if (_companySettings.OperatesOvernight)
                                            {
                                                <span>(virada após a meia-noite)</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Modelo de folga</dt>
                                        <dd>@DesignSystemDisplayHelper.FormatScheduleModel(_companySettings.ScheduleModel)</dd>
                                    </div>
                                </dl>
                            </ChildContent>
                            <FooterContent>
                                <div class="home-page__actions">
                                    <a class="home-page__cta" href="/demand">Importar &amp; Mapear Demanda</a>
                                    <a class="home-page__cta home-page__cta--secondary" href="/financial">Simular Impacto Financeiro</a>
                                    <a class="home-page__cta home-page__cta--secondary" href="/employees">Gerenciar Equipe &amp; Polivalência</a>
                                    <a class="home-page__cta home-page__cta--secondary" href="/roster">Painel da Escala 5x2</a>
                                    <a class="home-page__cta home-page__cta--secondary" href="/settings/company">Editar Configurações da Casa</a>
                                </div>
                            </FooterContent>
                        </AppCard>

                        @if (_pendingManagerSwaps > 0)
                        {
                            <AppCard Title="Trocas de Turno Aguardando Aprovação"
                                     Subtitle="@($"Existem {_pendingManagerSwaps} solicitações confirmadas pelos colegas aguardando sua autorização em 1 clique.")"
                                     Border="AppCardBorder.Warning"
                                     data-testid="home-pending-swaps-card">
                                <HeaderContent>
                                    <AppBadge Variant="AppBadgeVariant.Warning" Text="@($"{_pendingManagerSwaps} pendente(s)")" Dot="true" />
                                </HeaderContent>
                                <FooterContent>
                                    <a class="home-page__cta" href="/roster#swap-approvals">Revisar e Aprovar Trocas</a>
                                </FooterContent>
                            </AppCard>
                        }
                    }
                    else
                    {
                        <AppCard Title="Complete o Onboarding da Casa"
                                 Subtitle="Cadastre o perfil operacional, horários e modelo de folga para iniciar a transição 5x2."
                                 Border="AppCardBorder.Primary">
                            <HeaderContent>
                                <AppBadge Variant="AppBadgeVariant.Warning" Text="Passo 1 pendente" Dot="true" />
                            </HeaderContent>
                            <FooterContent>
                                <a class="home-page__cta" href="/onboarding">Iniciar Onboarding</a>
                            </FooterContent>
                        </AppCard>
                    }
                }
                else
                {
                    <AppCard Title="Área do Colaborador"
                             Subtitle="Acesso operacional ativo. Consulte seus turnos e solicite trocas pelo painel da escala.">
                        <FooterContent>
                            <a class="home-page__cta" href="/roster">Acessar Minha Escala</a>
                        </FooterContent>
                    </AppCard>
                }
            </section>
        </Authorized>
    </AuthorizeView>

    <!-- SECTION 1: HERO & VISUAL SIGNATURE CARD -->
    <header class="landing-hero" id="diagnostico">
        <div class="landing-hero__grid">
            <!-- Coluna Esquerda: Proposta de Valor Executiva -->
            <div class="landing-hero__content">
                <div class="landing-hero__badge">
                    <span class="landing-hero__badge-dot"></span>
                    <span>Emenda Constitucional 141 · Prazo até 16/12/2026</span>
                </div>

                <h1 class="landing-hero__title">
                    Passe da escala <span class="landing-text-primary">6x1</span> para a <span class="landing-text-tertiary">5x2</span> sem perder margem nem equipe.
                </h1>

                <p class="landing-hero__subtitle">
                    Redesenhamos a escala função por função: cumpra a nova legislação trabalhista com o menor custo na folha e sem deixar nenhum posto de atendimento descoberto.
                </p>

                <div class="landing-hero__actions">
                    <AuthorizeView>
                        <Authorized>
                            <a class="landing-btn-primary" href="/onboarding">
                                <span>Acessar Plataforma 5x2</span>
                                <span class="material-symbols-outlined">arrow_forward</span>
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a class="landing-btn-primary" href="/Account/Register">
                                <span>Fazer Diagnóstico Gratuito (3 min)</span>
                                <span class="material-symbols-outlined">arrow_forward</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>

                    <a class="landing-btn-secondary" href="#os-4-caminhos">
                        <span class="material-symbols-outlined text-secondary">visibility</span>
                        <span>Ver demonstração dos 4 caminhos</span>
                    </a>
                </div>

                <div class="landing-hero__trust">
                    <span class="material-symbols-outlined landing-hero__trust-icon">lock</span>
                    <span>Suas respostas não exigem cadastro e ficam salvas apenas no seu aparelho.</span>
                </div>
            </div>

            <!-- Coluna Direita: Cartão Assinatura Visual (Simulador de Transição) -->
            <div class="landing-hero__signature">
                <div class="signature-card">
                    <div class="signature-card__glow" aria-hidden="true"></div>

                    <!-- Topo do Cartão -->
                    <div class="signature-card__header">
                        <span class="signature-card__pill">Simulador de Transição</span>
                        <div class="signature-card__countdown">
                            <span class="material-symbols-outlined">timer</span>
                            <span>@DaysRemaining Dias p/ vigência</span>
                        </div>
                    </div>

                    <!-- Ribbon Central da Matriz Semanal -->
                    <div class="signature-card__matrix">
                        <div class="signature-card__matrix-header">
                            <span class="signature-card__matrix-label">Matriz Semanal de Postos</span>
                            <span class="signature-card__matrix-tag">6x1 &rarr; 5x2 Dinâmico</span>
                        </div>

                        <div class="signature-card__days-grid">
                            <!-- Seg (Folga Extra) -->
                            <div class="signature-card__day signature-card__day--highlight">
                                <span class="signature-card__day-name">SEG</span>
                                <span class="signature-card__day-badge signature-card__day-badge--folga">Folga+</span>
                                <span class="material-symbols-outlined signature-card__day-icon text-warning">celebration</span>
                            </div>
                            <!-- Ter -->
                            <div class="signature-card__day">
                                <span class="signature-card__day-name">TER</span>
                                <span class="signature-card__day-badge">Turno</span>
                                <span class="material-symbols-outlined signature-card__day-icon">check</span>
                            </div>
                            <!-- Qua -->
                            <div class="signature-card__day">
                                <span class="signature-card__day-name">QUA</span>
                                <span class="signature-card__day-badge">Turno</span>
                                <span class="material-symbols-outlined signature-card__day-icon">check</span>
                            </div>
                            <!-- Qui -->
                            <div class="signature-card__day">
                                <span class="signature-card__day-name">QUI</span>
                                <span class="signature-card__day-badge">Turno</span>
                                <span class="material-symbols-outlined signature-card__day-icon">check</span>
                            </div>
                            <!-- Sex -->
                            <div class="signature-card__day">
                                <span class="signature-card__day-name">SEX</span>
                                <span class="signature-card__day-badge">Turno</span>
                                <span class="material-symbols-outlined signature-card__day-icon">check</span>
                            </div>
                            <!-- Sab -->
                            <div class="signature-card__day">
                                <span class="signature-card__day-name">SAB</span>
                                <span class="signature-card__day-badge">Pico</span>
                                <span class="material-symbols-outlined signature-card__day-icon text-alert">local_fire_department</span>
                            </div>
                            <!-- Dom (DSR) -->
                            <div class="signature-card__day signature-card__day--dsr">
                                <span class="signature-card__day-name">DOM</span>
                                <span class="signature-card__day-badge signature-card__day-badge--dsr">DSR</span>
                                <span class="material-symbols-outlined signature-card__day-icon">bed</span>
                            </div>
                        </div>
                    </div>

                    <!-- Bento Flutuante de Impacto -->
                    <div class="signature-bento">
                        <div class="signature-bento__top">
                            <div class="signature-bento__info">
                                <div class="signature-bento__icon-box">
                                    <span class="material-symbols-outlined">verified</span>
                                </div>
                                <div>
                                    <span class="signature-bento__tag">Melhor Conta Apurada</span>
                                    <div class="signature-bento__title">Rodízio Inteligente Setorizado</div>
                                </div>
                            </div>
                            <div class="signature-bento__metric">
                                <span class="signature-bento__value">-R$ 1.846/mês</span>
                                <span class="signature-bento__unit">folha otimizada</span>
                            </div>
                        </div>

                        <div class="signature-bento__bottom">
                            <span class="signature-bento__positive">
                                <span class="material-symbols-outlined">trending_up</span>
                                +18% de prontidão nos picos
                            </span>
                            <span class="signature-bento__neutral">0 postos descobertos</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- SECTION 2: PROVA SOCIAL E CONTEXTO ESTATÍSTICO -->
    <section class="landing-stats" aria-label="Estatísticas da Transição 5x2">
        <div class="landing-stats__grid">
            <div class="landing-stat-card">
                <span class="landing-stat-card__number">14,8 mi</span>
                <span class="landing-stat-card__label">Trabalhadores na escala 6x1 em migração no Brasil.</span>
            </div>
            <div class="landing-stat-card">
                <span class="landing-stat-card__number landing-text-primary">+4,7% a +7,8%</span>
                <span class="landing-stat-card__label">Aumento previsto na folha para quem não recalcular a escala.</span>
            </div>
            <div class="landing-stat-card">
                <span class="landing-stat-card__number">596 mil</span>
                <span class="landing-stat-card__label">Empregos formais diretamente impactados só na Bahia.</span>
            </div>
            <div class="landing-stat-card">
                <span class="landing-stat-card__number landing-text-success">R$ 0</span>
                <span class="landing-stat-card__label">Custo para gerar o diagnóstico preliminar da sua empresa.</span>
            </div>
        </div>
    </section>

    <!-- SECTION 3: O PROBLEMA & URGÊNCIA (MOSAICO COMPARATIVO) -->
    <section class="landing-section" aria-labelledby="problem-heading">
        <div class="landing-section__header">
            <span class="landing-section-tag">Urgência Operacional &amp; Risco Trabalhista</span>
            <h2 id="problem-heading" class="landing-section__title">
                A regra mudou. Quem deixar para a última hora vai pagar hora extra em dobro.
            </h2>
            <p class="landing-section__subtitle">
                A adequação não é só alterar o relógio de ponto: sem reorganizar folgas e postos, sua empresa absorve o custo da ineficiência ou sofre autuações severas do MTE.
            </p>
        </div>

        <div class="landing-mosaic-grid">
            <!-- Cenário Negativo: Sem Planejamento -->
            <div class="landing-scenario-card landing-scenario-card--risk">
                <div class="landing-scenario-card__bar landing-scenario-card__bar--risk"></div>
                <div class="landing-scenario-card__header">
                    <span class="landing-scenario-card__badge landing-scenario-card__badge--risk">&times;</span>
                    <h3 class="landing-scenario-card__title landing-scenario-card__title--risk">
                        Sem Planejamento (Risco Iminente)
                    </h3>
                </div>
                <ul class="landing-scenario-card__list">
                    <li>
                        <span class="material-symbols-outlined text-alert">warning</span>
                        <div>
                            <strong>Horas extras não autorizadas (+50% a +100%)</strong>
                            <span>A ausência repentina de escala planejada faz com que postos vazios sejam cobertos com custos astronômicos de sobrejornada.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-alert">gavel</span>
                        <div>
                            <strong>Passivos trabalhistas e fiscalização do MTE</strong>
                            <span>Multas pesadas por descumprimento dos limites constitucionais de repouso semanal remunerado (DSR) contínuo.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-alert">sentiment_very_dissatisfied</span>
                        <div>
                            <strong>Equipe exausta, turnover elevado e atestados</strong>
                            <span>Sobrecarga nos dias de pico, desmotivação crônica e desfalques não previstos nos turnos de abertura e fechamento.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-alert">trending_down</span>
                        <div>
                            <strong>Contratações apressadas inflando a folha fixa</strong>
                            <span>Admissão de novos quadros sem calcular a real densidade de público diária, corroendo a margem do negócio.</span>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Cenário Positivo: Com a Virada 5x2 -->
            <div class="landing-scenario-card landing-scenario-card--safe">
                <div class="landing-scenario-card__bar landing-scenario-card__bar--safe"></div>
                <div class="landing-scenario-card__header">
                    <span class="landing-scenario-card__badge landing-scenario-card__badge--safe">&#10003;</span>
                    <h3 class="landing-scenario-card__title landing-scenario-card__title--safe">
                        Com a Virada 5x2 (Transição Segura)
                    </h3>
                </div>
                <ul class="landing-scenario-card__list">
                    <li>
                        <span class="material-symbols-outlined text-success">verified_user</span>
                        <div>
                            <strong>Simulação função por função sem postos vagos</strong>
                            <span>Mapeamento granular das funções essenciais e contingenciais para garantir atendimento 100% contínuo.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-success">sync_alt</span>
                        <div>
                            <strong>Turno otimizado e rodízio em dias de baixo movimento</strong>
                            <span>Folgas agrupadas nos períodos de receita fria, preservando força total na sexta, sábado e domingo.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-success">article</span>
                        <div>
                            <strong>Acordo coletivo e CCT blindados juridicamente</strong>
                            <span>Redação contratual homologável alinhada com as convenções sindicais vigentes e o novo texto da CLT.</span>
                        </div>
                    </li>
                    <li>
                        <span class="material-symbols-outlined text-success">loyalty</span>
                        <div>
                            <strong>Custo previsível e atração de talentos de ponta</strong>
                            <span>Folha controlada com redução expressiva do absenteísmo e melhoria imediata no NPS de atendimento ao cliente.</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- SECTION 4: OS 4 CAMINHOS PARA O 5x2 SUSTENTÁVEL -->
    <section class="landing-section landing-section--muted" id="os-4-caminhos" aria-labelledby="paths-heading">
        <div class="landing-section__header-row">
            <div>
                <span class="landing-section-tag landing-section-tag--tertiary">Metodologia de Transição</span>
                <h2 id="paths-heading" class="landing-section__title">
                    Os 4 Caminhos para o 5x2 Sustentável
                </h2>
                <p class="landing-section__subtitle">
                    Nem toda empresa precisa contratar para virar a chave. Descubra qual caminho se adapta à sazonalidade e ao fluxo do seu modelo de negócio.
                </p>
            </div>
            <a class="landing-section__link" href="/Account/Register">
                <span>Descobrir o caminho ideal para meu setor</span>
                <span class="material-symbols-outlined">chevron_right</span>
            </a>
        </div>

        <div class="landing-paths-grid">
            <!-- Caminho 1: Rodízio de Folgas -->
            <div class="landing-path-card landing-path-card--rodizio">
                <div class="landing-path-card__top">
                    <div class="landing-path-card__icon-row">
                        <span class="landing-path-card__icon landing-path-card__icon--rodizio">
                            <span class="material-symbols-outlined">restart_alt</span>
                        </span>
                        <span class="landing-path-card__badge landing-path-card__badge--rodizio">Mais Procurado</span>
                    </div>
                    <h3 class="landing-path-card__title">Rodízio de Folgas</h3>
                    <p class="landing-path-card__desc">
                        Concentra folgas nos dias de menor fluxo mantendo a operação aberta 7 dias. A equipe se reveza por polivalência entre postos-chave.
                    </p>
                </div>
                <div class="landing-path-card__footer">
                    <span class="landing-path-card__target-label">Ideal para:</span>
                    <strong class="landing-path-card__target-value">Restaurantes, bares e varejo de shopping.</strong>
                </div>
            </div>

            <!-- Caminho 2: Fechar um Dia -->
            <div class="landing-path-card landing-path-card--fechar">
                <div class="landing-path-card__top">
                    <div class="landing-path-card__icon-row">
                        <span class="landing-path-card__icon landing-path-card__icon--fechar">
                            <span class="material-symbols-outlined">door_front</span>
                        </span>
                        <span class="landing-path-card__badge landing-path-card__badge--fechar">Custo Zero</span>
                    </div>
                    <h3 class="landing-path-card__title">Fechar um Dia</h3>
                    <p class="landing-path-card__desc">
                        Todos folgam juntos no dia de menor receita histórica (ex: segunda-feira). Economia drástica de insumos, luz, água e ar-condicionado.
                    </p>
                </div>
                <div class="landing-path-card__footer">
                    <span class="landing-path-card__target-label">Ideal para:</span>
                    <strong class="landing-path-card__target-value">Bistrôs, clínicas e serviços de rua.</strong>
                </div>
            </div>

            <!-- Caminho 3: 1 Hora a Menos -->
            <div class="landing-path-card landing-path-card--hora">
                <div class="landing-path-card__top">
                    <div class="landing-path-card__icon-row">
                        <span class="landing-path-card__icon landing-path-card__icon--hora">
                            <span class="material-symbols-outlined">schedule</span>
                        </span>
                        <span class="landing-path-card__badge landing-path-card__badge--hora">Transição Suave</span>
                    </div>
                    <h3 class="landing-path-card__title">1 Hora a Menos</h3>
                    <p class="landing-path-card__desc">
                        Redução sutil da jornada diária mantendo o número de dias abertos. Foco estrito em horários nobres de atendimento e produtividade.
                    </p>
                </div>
                <div class="landing-path-card__footer">
                    <span class="landing-path-card__target-label">Ideal para:</span>
                    <strong class="landing-path-card__target-value">Escritórios, logística, comércio atacadista.</strong>
                </div>
            </div>

            <!-- Caminho 4: Escala 12x36 -->
            <div class="landing-path-card landing-path-card--12x36">
                <div class="landing-path-card__top">
                    <div class="landing-path-card__icon-row">
                        <span class="landing-path-card__icon landing-path-card__icon--12x36">
                            <span class="material-symbols-outlined">bed</span>
                        </span>
                        <span class="landing-path-card__badge landing-path-card__badge--12x36">Operação 24/7</span>
                    </div>
                    <h3 class="landing-path-card__title">Escala 12x36</h3>
                    <p class="landing-path-card__desc">
                        Dois dias trabalhados por semana para operações ininterruptas, com 36 horas ininterruptas de descanso pós-turno.
                    </p>
                </div>
                <div class="landing-path-card__footer">
                    <span class="landing-path-card__target-label">Ideal para:</span>
                    <strong class="landing-path-card__target-value">Segurança, portaria, hotelaria e saúde.</strong>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 5: CASOS REAIS & EVIDÊNCIAS DE MERCADO -->
    <section class="landing-section" id="casos-reais" aria-labelledby="cases-heading">
        <div class="landing-section__header">
            <span class="landing-section-tag landing-section-tag--success">Resultados Comprovados</span>
            <h2 id="cases-heading" class="landing-section__title">
                Quem já virou a chave não volta atrás
            </h2>
            <p class="landing-section__subtitle">
                Dados empíricos de operações brasileiras que implementaram jornadas concentradas e modelos 5x2.
            </p>
        </div>

        <div class="landing-benchmarks-grid">
            <!-- Case 1: Gurumê -->
            <div class="landing-benchmark-card">
                <div>
                    <div class="landing-benchmark-card__brand text-primary">
                        <span class="material-symbols-outlined">restaurant</span>
                        <h3 class="landing-benchmark-card__name">Gurumê</h3>
                    </div>
                    <span class="landing-benchmark-card__segment">Gastronomia Premium</span>
                    <p class="landing-benchmark-card__quote">
