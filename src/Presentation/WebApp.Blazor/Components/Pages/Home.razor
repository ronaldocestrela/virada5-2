@page "/"
@using Application.Common.Interfaces
@using Application.DTOs.Companies
@using Application.UseCases.Companies
@using Application.UseCases.Rosters
@using Infrastructure.Data.Identity
@using WebApp.Blazor.Helpers

@inject GetCurrentCompanySettingsUseCase GetCurrentCompanySettingsUseCase
@inject GetPendingShiftSwapsUseCase GetPendingShiftSwapsUseCase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IShiftSwapNotificationService ShiftSwapNotificationService
@implements IDisposable

<PageTitle>Visão Geral — Virada 5x2</PageTitle>

<div class="home-page">
    <header class="home-page__header">
        <h1>SaaS de Transição 5x2</h1>
        <p class="home-page__subtitle">
            Planeje a transição da escala 6x1 para 5x2 com conformidade trabalhista CLT e cobertura inteligente dos picos de demanda.
        </p>
    </header>

    <AuthorizeView>
        <Authorized>
            @if (context.User.IsInRole(ApplicationRoles.Owner) || context.User.IsInRole(ApplicationRoles.Manager))
            {
                @if (_companySettings is not null)
                {
                    <AppCard Title="@_companySettings.Name"
                             Subtitle="@DesignSystemDisplayHelper.FormatBusinessType(_companySettings.BusinessType)">
                        <HeaderContent>
                            <AppBadge Variant="AppBadgeVariant.Success" Text="Casa configurada" Dot="true" />
                        </HeaderContent>
                        <ChildContent>
                            <dl class="home-page__summary">
                                <div>
                                    <dt>Funcionamento</dt>
                                    <dd>
                                        @_companySettings.OpeningTime.ToString("HH:mm") às @_companySettings.ClosingTime.ToString("HH:mm")
                                        @if (_companySettings.OperatesOvernight)
                                        {
                                            <span>(virada após a meia-noite)</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt>Modelo de folga</dt>
                                    <dd>@DesignSystemDisplayHelper.FormatScheduleModel(_companySettings.ScheduleModel)</dd>
                                </div>
                            </dl>
                        </ChildContent>
                        <FooterContent>
                            <div class="home-page__actions">
                                <a class="home-page__cta" href="/demand">Importar &amp; Mapear Demanda</a>
                                <a class="home-page__cta home-page__cta--secondary" href="/financial">Simular Impacto Financeiro</a>
                                <a class="home-page__cta home-page__cta--secondary" href="/employees">Gerenciar Equipe &amp; Polivalência</a>
                                <a class="home-page__cta home-page__cta--secondary" href="/roster">Painel da Escala 5x2</a>
                                <a class="home-page__cta home-page__cta--secondary" href="/settings/company">Editar Configurações da Casa</a>
                            </div>
                        </FooterContent>
                    </AppCard>

                    @if (_pendingManagerSwaps > 0)
                    {
                        <AppCard Title="Trocas de Turno Aguardando Aprovação"
                                 Subtitle="@($"Existem {_pendingManagerSwaps} solicitações confirmadas pelos colegas aguardando sua autorização em 1 clique.")"
                                 Border="AppCardBorder.Warning"
                                 data-testid="home-pending-swaps-card">
                            <HeaderContent>
                                <AppBadge Variant="AppBadgeVariant.Warning" Text="@($"{_pendingManagerSwaps} pendente(s)")" Dot="true" />
                            </HeaderContent>
                            <FooterContent>
                                <a class="home-page__cta" href="/roster#swap-approvals">Revisar e Aprovar Trocas</a>
                            </FooterContent>
                        </AppCard>
                    }
                }
                else
                {
                    <AppCard Title="Complete o Onboarding da Casa"
                             Subtitle="Cadastre o perfil operacional, horários e modelo de folga para iniciar a transição 5x2."
                             Border="AppCardBorder.Primary">
                        <HeaderContent>
                            <AppBadge Variant="AppBadgeVariant.Warning" Text="Passo 1 pendente" Dot="true" />
                        </HeaderContent>
                        <FooterContent>
                            <a class="home-page__cta" href="/onboarding">Iniciar Onboarding</a>
                        </FooterContent>
                    </AppCard>
                }
            }
            else
            {
                <AppCard Title="Área do Colaborador"
                         Subtitle="Acesso operacional ativo. Em breve você poderá consultar seus turnos e solicitar trocas por aqui.">
                </AppCard>
            }
        </Authorized>
        <NotAuthorized>
            <AppCard Title="Bem-vindo ao Virada 5x2"
                     Subtitle="Acesse sua conta para configurar seu estabelecimento e gerar escalas 5x2 otimizadas.">
                <FooterContent>
                    <a class="home-page__cta" href="/Account/Login">Entrar na Plataforma</a>
                </FooterContent>
            </AppCard>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private CompanySettingsDto? _companySettings;
    private int _pendingManagerSwaps;
    private Guid _currentTenantId;
    private bool _isManagerOrOwner;
    private bool _disposed;

    protected override void OnInitialized()
    {
        ShiftSwapNotificationService.OnTenantSwapsChanged += HandleTenantSwapsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (!user.IsInRole(ApplicationRoles.Owner) && !user.IsInRole(ApplicationRoles.Manager))
        {
            return;
        }

        _isManagerOrOwner = true;
        var tenantClaim = user.FindFirst(TenantClaimTypes.TenantId)?.Value;
        _ = Guid.TryParse(tenantClaim, out _currentTenantId);

        var result = await GetCurrentCompanySettingsUseCase.ExecuteAsync();
        if (result.IsSuccess)
        {
            _companySettings = result.Value;
            await RefreshPendingSwapsAsync();
        }
    }

    private void HandleTenantSwapsChanged(Guid tenantId)
    {
        if (_disposed || !_isManagerOrOwner || _currentTenantId == Guid.Empty || tenantId != _currentTenantId || _companySettings is null)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await RefreshPendingSwapsAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshPendingSwapsAsync()
    {
        var swapsResult = await GetPendingShiftSwapsUseCase.ExecuteAsync(
            new GetPendingShiftSwapsCommand(IncludeCltEvaluation: false));
        if (swapsResult.IsSuccess)
        {
            _pendingManagerSwaps = swapsResult.Value.PendingManagerApprovalCount;
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        ShiftSwapNotificationService.OnTenantSwapsChanged -= HandleTenantSwapsChanged;
    }
}
