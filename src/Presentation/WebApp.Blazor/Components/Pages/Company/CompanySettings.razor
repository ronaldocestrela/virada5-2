@page "/onboarding"
@page "/settings/company"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{ApplicationRoles.Owner},{ApplicationRoles.Manager}")]

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Application.DTOs.Companies
@using Application.UseCases.Companies
@using Domain.Entities
@using Domain.Enums
@using Infrastructure.Data.Identity
@using WebApp.Blazor.Helpers
@using WebApp.Blazor.Services

@inject GetCurrentCompanySettingsUseCase GetCurrentCompanySettingsUseCase
@inject SaveCompanySettingsUseCase SaveCompanySettingsUseCase
@inject IToastService ToastService

<PageTitle>@PageTitleText — Virada 5x2</PageTitle>

<div class="company-settings">
    <header class="company-settings__header">
        <div class="company-settings__badge-step">
            <span class="company-settings__step-pill">
                <span class="company-settings__step-dot" aria-hidden="true"></span>
                @(_isOnboarding ? "Passo 1 de 5 • Jornada de Implantação 5x2" : "Configurações da Casa • Unidade Ativa")
            </span>
        </div>

        <div class="company-settings__title-row">
            <div>
                <h1>@PageTitleText</h1>
                <p class="company-settings__subtitle">
                    Configure o perfil operacional, a janela de atendimento e a estratégia de folgas da casa para calibrar o motor 5x2.
                </p>
            </div>
            <AppBadge Variant="@(_isOnboarding ? AppBadgeVariant.Warning : AppBadgeVariant.Success)"
                      Text="@(_isOnboarding ? "Configuração pendente" : "Casa configurada")"
                      Dot="true" />
        </div>

        <div class="company-settings__clt-banner">
            <div class="company-settings__clt-banner-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
            </div>
            <div class="company-settings__clt-banner-content">
                <div class="company-settings__clt-banner-title">
                    <strong>Motor de Validação CLT Ativo</strong>
                    <span class="company-settings__clt-tag">Conforme CLT 2025</span>
                </div>
                <p>
                    Verificação contínua de 11h de descanso interjornada, limite de 44h semanais e garantia de 2 folgas na calibragem do motor 5x2.
                </p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_formErrorMessage))
    {
        <div class="company-settings__alert" role="alert">
            <span class="company-settings__alert-icon" aria-hidden="true">⚠️</span>
            <span>@_formErrorMessage</span>
        </div>
    }

    <EditForm Model="Form"
              FormName="company-settings"
              OnValidSubmit="HandleValidSubmitAsync"
              class="company-settings__form">
        <DataAnnotationsValidator />

        <div class="company-settings__grid">
            <AppCard Title="1. Identificação e Operação"
                     Subtitle="Nome comercial e segmento de atendimento para referência nas escalas.">
                <div class="company-settings__fields">
                    <AppInputText Id="company-name"
                                  name="Form.Name"
                                  Label="Nome do estabelecimento"
                                  Placeholder="Ex.: Bistrô Central"
                                  HelperText="Exibido nos relatórios, simuladores e escalas publicadas."
                                  Required="true"
                                  MaxLength="@Company.MaxNameLength"
                                  @bind-Value="Form.Name" />

                    <div class="company-settings__business-type-wrapper">
                        <AppInputSelect TValue="BusinessType"
                                        Id="company-business-type"
                                        name="Form.BusinessType"
                                        Label="Tipo de operação"
                                        HelperText="Define o contexto operacional e dimensionamento de cozinha e salão."
                                        Required="true"
                                        Options="@_businessTypeOptions"
                                        @bind-Value="Form.BusinessType" />

                        <div class="company-settings__segment-cards" role="group" aria-label="Seleção rápida de segmento">
                            @foreach (var type in _quickSegments)
                            {
                                var isCurrent = Form.BusinessType == type;
                                <button type="button"
                                        class="company-settings__segment-pill @(isCurrent ? "company-settings__segment-pill--active" : string.Empty)"
                                        @onclick="() => SelectBusinessType(type)">
                                    <span class="company-settings__segment-icon" aria-hidden="true">@GetBusinessTypeIcon(type)</span>
                                    <span>@DesignSystemDisplayHelper.FormatBusinessType(type)</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </AppCard>

            <AppCard Title="2. Janela de Funcionamento"
                     Subtitle="Horário padrão de abertura e encerramento das operações diárias.">
                <div class="company-settings__hours-grid">
                    <AppInputText Id="company-opening-time"
                                  name="Form.OpeningTimeText"
                                  Label="Horário de abertura"
                                  Type="time"
                                  Required="true"
                                  @bind-Value="Form.OpeningTimeText" />

                    <AppInputText Id="company-closing-time"
                                  name="Form.ClosingTimeText"
                                  Label="Horário de fechamento"
                                  Type="time"
                                  Required="true"
                                  @bind-Value="Form.ClosingTimeText" />
                </div>

                @if (IsOvernightPreview)
                {
                    <div class="company-settings__overnight" data-testid="overnight-indicator">
                        <AppBadge Variant="AppBadgeVariant.Info" Text="Turno noturno" Dot="true" />
                        <span>Operação estendida após a meia-noite (@ComputeDailyDurationLabel()). Adicional noturno e hora ficta aplicados.</span>
                    </div>
                }
                else if (TryParseTimes(out _, out _))
                {
                    <p class="company-settings__duration-hint">
                        Janela diária configurada: @ComputeDailyDurationLabel().
                    </p>
                }

                @if (TryParseTimes(out _, out _))
                {
                    <div class="company-settings__timeline" aria-hidden="true">
                        <div class="company-settings__timeline-track">
                            <div class="company-settings__timeline-range"></div>
                        </div>
                        <div class="company-settings__timeline-labels">
                            <span>00:00</span>
                            <span>06:00</span>
                            <span>12:00</span>
                            <span>18:00</span>
                            <span>24:00</span>
                        </div>
                    </div>
                }

                <div class="company-settings__tip">
                    <span class="company-settings__tip-icon" aria-hidden="true">💡</span>
                    <span><strong>Dica de Otimização:</strong> A janela cadastrada calibra a geração automática de turnos diretos e escalonados, minimizando horas extras desnecessárias e garantindo 11h de descanso interjornada.</span>
                </div>
            </AppCard>
        </div>

        <AppCard Title="3. Modelo de Folga Pretendido"
                 Subtitle="Escolha se o estabelecimento fecha em dias fixos da semana ou opera os 7 dias com folgas rotativas.">
            <div class="company-settings__model-options" role="radiogroup" aria-label="Modelo de folga pretendido">
                <label class="@BuildModelCardClass(ScheduleModel.RotatingDaysOff)" for="schedule-model-rotating">
                    <input id="schedule-model-rotating"
                           class="company-settings__radio"
                           type="radio"
                           name="Form.ScheduleModel"
                           value="@ScheduleModel.RotatingDaysOff"
                           checked="@(Form.ScheduleModel == ScheduleModel.RotatingDaysOff)"
                           @onclick="() => SelectScheduleModel(ScheduleModel.RotatingDaysOff)"
                           @onchange="() => SelectScheduleModel(ScheduleModel.RotatingDaysOff)" />
                    <div class="company-settings__model-content">
                        <div class="company-settings__model-header-row">
                            <strong>Folga rotativa (7 dias abertos)</strong>
                            <span class="company-settings__model-tag company-settings__model-tag--recommended">Recomendado</span>
                        </div>
                        <p>A casa abre todos os dias e o motor aloca as 2 folgas semanais de cada colaborador nos vales de menor movimento.</p>
                        <div class="company-settings__model-benefit">
                            <span class="company-settings__check-icon" aria-hidden="true">✓</span>
                            <span>Zero perda de faturamento semanal • Rotação equitativa</span>
                        </div>
                    </div>
                </label>

                <label class="@BuildModelCardClass(ScheduleModel.FixedClosure)" for="schedule-model-fixed">
                    <input id="schedule-model-fixed"
                           class="company-settings__radio"
                           type="radio"
                           name="Form.ScheduleModel"
                           value="@ScheduleModel.FixedClosure"
                           checked="@(Form.ScheduleModel == ScheduleModel.FixedClosure)"
                           @onclick="() => SelectScheduleModel(ScheduleModel.FixedClosure)"
                           @onchange="() => SelectScheduleModel(ScheduleModel.FixedClosure)" />
                    <div class="company-settings__model-content">
                        <div class="company-settings__model-header-row">
                            <strong>Fechamento fixo</strong>
                            <span class="company-settings__model-tag">Modelo com pausa</span>
                        </div>
                        <p>A casa fecha em dias específicos da semana (ex.: segunda e terça) e concentra parte das folgas nesses dias.</p>
                        <div class="company-settings__model-benefit">
                            <span class="company-settings__check-icon" aria-hidden="true">✓</span>
                            <span>Previsibilidade total • Redução de custos fixos da operação</span>
                        </div>
                    </div>
                </label>
            </div>

            @if (Form.ScheduleModel == ScheduleModel.FixedClosure)
            {
                <div class="company-settings__closed-days">
                    <div class="company-settings__closed-days-header">
                        <span class="company-settings__closed-days-title">Dias de fechamento fixo</span>
                        <span class="company-settings__closed-days-count">
                            @Form.SelectedClosedDays.Count dia(s) fechado(s) · @(7 - Form.SelectedClosedDays.Count) dia(s) aberto(s)
                        </span>
                    </div>

                    <div class="company-settings__days-grid">
                        @foreach (var day in DesignSystemDisplayHelper.OperationalWeekOrder)
                        {
                            var isSelected = Form.SelectedClosedDays.Contains(day);
                            <label class="@BuildDayChipClass(isSelected)" for="@($"closed-day-{day}")">
                                <input id="@($"closed-day-{day}")"
                                       class="company-settings__day-checkbox"
                                       type="checkbox"
                                       name="Form.SelectedClosedDays"
                                       value="@day"
                                       checked="@isSelected"
                                       @onchange="args => ToggleClosedDay(day, ParseCheckboxValue(args.Value))" />
                                <span>@DesignSystemDisplayHelper.FormatDayShort(day)</span>
                            </label>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="company-settings__rotating-note">
                    No modelo rotativo, todos os 7 dias da semana permanecem abertos e nenhuma folga fixa de fechamento é bloqueada. O algoritmo otimiza as folgas individuais respeitando o revezamento dominical CLT.
                </p>
            }

            <div class="company-settings__legal-callout">
                <span class="company-settings__legal-icon" aria-hidden="true">⚖️</span>
                <div>
                    <strong>Revezamento Dominical Inteligente (Art. 386 CLT)</strong>
                    <p>O algoritmo da escala 5x2 prioriza automaticamente o descanso dominical legal em comércio e gastronomia, prevenindo passivos trabalhistas.</p>
                </div>
            </div>
        </AppCard>

        @if (_savedCompany is not null)
        {
            <AppCard Title="Resumo Atual da Casa"
                     Subtitle="Configuração persistida e utilizada pelos motores de demanda, viabilidade financeira e escala 5x2."
                     Border="AppCardBorder.Success"
                     data-testid="company-summary">
                <div class="company-settings__summary-grid">
                    <div>
                        <span class="company-settings__summary-label">Estabelecimento</span>
                        <strong>@_savedCompany.Name</strong>
                    </div>
                    <div>
                        <span class="company-settings__summary-label">Operação</span>
                        <strong>@DesignSystemDisplayHelper.FormatBusinessType(_savedCompany.BusinessType)</strong>
                    </div>
                    <div>
                        <span class="company-settings__summary-label">Horário</span>
                        <strong>@_savedCompany.OpeningTime.ToString("HH:mm") – @_savedCompany.ClosingTime.ToString("HH:mm")</strong>
                    </div>
                    <div>
                        <span class="company-settings__summary-label">Modelo 5x2</span>
                        <strong>@DesignSystemDisplayHelper.FormatScheduleModel(_savedCompany.ScheduleModel)</strong>
                    </div>
                </div>

                <div class="company-settings__summary-badges">
                    <span class="company-settings__summary-badge company-settings__summary-badge--active">
                        <span class="company-settings__summary-dot"></span> Motor de Demanda Calibrado
                    </span>
                    <span class="company-settings__summary-badge company-settings__summary-badge--active">
                        <span class="company-settings__summary-dot"></span> Simulador Financeiro Ativo
                    </span>
                    <span class="company-settings__summary-badge company-settings__summary-badge--active">
                        <span class="company-settings__summary-dot"></span> 100% Conforme CLT
                    </span>
                </div>
            </AppCard>
        }

        <div class="company-settings__actions-bar">
            <div class="company-settings__actions-info">
                <span class="company-settings__actions-cloud-icon" aria-hidden="true">☁️</span>
                <span>Parâmetros sincronizados com os motores de escala, demanda e financeiro.</span>
            </div>

            <div class="company-settings__actions">
                <AppButton Type="submit"
                           Variant="AppButtonVariant.Primary"
                           Size="AppButtonSize.Large"
                           Loading="_isSaving"
                           Disabled="_isLoading">
                    @(_isOnboarding ? "Concluir Onboarding" : "Salvar Configurações")
                </AppButton>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private static readonly IReadOnlyList<SelectOption<BusinessType>> _businessTypeOptions =
        Enum.GetValues<BusinessType>()
            .Select(type => new SelectOption<BusinessType>(type, DesignSystemDisplayHelper.FormatBusinessType(type)))
            .ToList();

    private static readonly BusinessType[] _quickSegments =
    [
        BusinessType.Restaurant,
        BusinessType.Bar,
        BusinessType.CafeBakery,
        BusinessType.FastFood
    ];

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isOnboarding = true;
    private bool _hasSubmittedForm;
    private string? _formErrorMessage;
    private CompanySettingsDto? _savedCompany;
    private CompanyFormModel _form = new();

    [SupplyParameterFromForm(FormName = "company-settings")]
    private CompanyFormModel Form
    {
        get => _form;
        set
        {
            if (value is not null)
            {
                value.SelectedClosedDays ??= [];
                _form = value;
                _hasSubmittedForm = true;
            }
        }
    }

    private string PageTitleText => _isOnboarding ? "Onboarding da Casa" : "Configurações da Casa";

    private bool IsOvernightPreview =>
        TryParseTimes(out var opening, out var closing) && closing < opening;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        var result = await GetCurrentCompanySettingsUseCase.ExecuteAsync();
        if (result.IsSuccess)
        {
            if (_hasSubmittedForm)
            {
                _savedCompany = result.Value;
            }
            else
            {
                ApplyDtoToForm(result.Value);
            }

            _isOnboarding = false;
        }
        else if (result.Error.Code == "Company.NotFound")
        {
            _isOnboarding = true;
            _savedCompany = null;
        }
        else
        {
            _formErrorMessage = result.Error.Message;
            ToastService.ShowFromResult(result);
        }

        _isLoading = false;
    }

    protected override void OnParametersSet()
    {
        _form ??= new();
        _form.SelectedClosedDays ??= [];
    }

    private void ApplyDtoToForm(CompanySettingsDto dto)
    {
        _savedCompany = dto;
        Form.Name = dto.Name;
        Form.BusinessType = dto.BusinessType;
        Form.OpeningTimeText = dto.OpeningTime.ToString("HH:mm", CultureInfo.InvariantCulture);
        Form.ClosingTimeText = dto.ClosingTime.ToString("HH:mm", CultureInfo.InvariantCulture);
        Form.ScheduleModel = dto.ScheduleModel;
        Form.SelectedClosedDays = dto.ClosedDays.ToHashSet();
    }

    private void SelectBusinessType(BusinessType businessType)
    {
        Form.BusinessType = businessType;
        _formErrorMessage = null;
    }

    private void SelectScheduleModel(ScheduleModel scheduleModel)
    {
        Form.ScheduleModel = scheduleModel;
        _formErrorMessage = null;

        if (scheduleModel == ScheduleModel.RotatingDaysOff)
        {
            Form.SelectedClosedDays.Clear();
        }
    }

    private void ToggleClosedDay(DayOfWeek day, bool isChecked)
    {
        _formErrorMessage = null;
        if (isChecked)
        {
            Form.SelectedClosedDays.Add(day);
        }
        else
        {
            Form.SelectedClosedDays.Remove(day);
        }
    }

    private async Task HandleValidSubmitAsync()
    {
        if (_isLoading || _isSaving)
        {
            return;
        }

        _formErrorMessage = null;

        if (!TryParseTimes(out var openingTime, out var closingTime))
        {
            _formErrorMessage = "Informe horários de abertura e fechamento válidos no formato HH:mm.";
            ToastService.Show("Horário inválido", _formErrorMessage, AppToastSeverity.Error);
            return;
        }

        _isSaving = true;
        try
        {
            var closedDays = Form.ScheduleModel == ScheduleModel.FixedClosure
                ? Form.SelectedClosedDays.ToList()
                : [];

            var command = new SaveCompanySettingsCommand(
                Form.Name ?? string.Empty,
                Form.BusinessType,
                openingTime,
                closingTime,
                Form.ScheduleModel,
                closedDays);

            var result = await SaveCompanySettingsUseCase.ExecuteAsync(command);
            if (result.IsFailure)
            {
                _formErrorMessage = result.Error.Message;
                ToastService.ShowFromResult(result);
                return;
            }

            var wasOnboarding = _isOnboarding;
            ApplyDtoToForm(result.Value);
            _isOnboarding = false;

            ToastService.ShowFromResult(
                result,
                wasOnboarding ? "Onboarding concluído" : "Configurações atualizadas",
                wasOnboarding
                    ? "Estabelecimento cadastrado com sucesso. Pronto para mapear a demanda."
                    : "As regras operacionais da casa foram salvas.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private bool TryParseTimes(out TimeOnly openingTime, out TimeOnly closingTime)
    {
        var openOk = TimeOnly.TryParseExact(
            Form.OpeningTimeText?.Trim(),
            "HH:mm",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out openingTime);

        var closeOk = TimeOnly.TryParseExact(
            Form.ClosingTimeText?.Trim(),
            "HH:mm",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out closingTime);

        return openOk && closeOk;
    }


    private string ComputeDailyDurationLabel()
    {
        if (!TryParseTimes(out var opening, out var closing))
        {
            return string.Empty;
        }

        var span = closing > opening
            ? closing - opening
            : TimeSpan.FromHours(24) - (opening - closing);

        return span.Minutes > 0
            ? $"{(int)span.TotalHours}h{span.Minutes:D2}min por dia"
            : $"{(int)span.TotalHours}h por dia";
    }

    private static string GetBusinessTypeIcon(BusinessType businessType) => businessType switch
    {
        BusinessType.Restaurant => "🍽️",
        BusinessType.Bar => "🍸",
        BusinessType.CafeBakery => "☕",
        BusinessType.FastFood => "🍔",
        BusinessType.DarkKitchen => "📦",
        _ => "🏢"
    };

    private string BuildModelCardClass(ScheduleModel model) =>
        Form.ScheduleModel == model
            ? "company-settings__model-card company-settings__model-card--selected"
            : "company-settings__model-card";

    private static string BuildDayChipClass(bool selected) =>
        selected
            ? "company-settings__day-chip company-settings__day-chip--selected"
            : "company-settings__day-chip";

    private static bool ParseCheckboxValue(object? value) => value switch
    {
        bool boolean => boolean,
        string text when bool.TryParse(text, out var parsed) => parsed,
        _ => false
    };

    private sealed class CompanyFormModel
    {
        private HashSet<DayOfWeek> _selectedClosedDays = [];

        [MaxLength(Company.MaxNameLength, ErrorMessage = "O nome do estabelecimento não pode exceder 150 caracteres.")]
        public string? Name { get; set; } = string.Empty;

        public BusinessType BusinessType { get; set; } = BusinessType.Restaurant;

        public string? OpeningTimeText { get; set; } = "11:00";

        public string? ClosingTimeText { get; set; } = "23:00";

        public ScheduleModel ScheduleModel { get; set; } = ScheduleModel.RotatingDaysOff;

        public HashSet<DayOfWeek> SelectedClosedDays
        {
            get => _selectedClosedDays;
            set => _selectedClosedDays = value ?? [];
        }
    }
}
