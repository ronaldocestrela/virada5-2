@page "/Error"
@using System.Diagnostics

<PageTitle>Erro inesperado — Virada 5x2</PageTitle>

<AppCard Title="Ocorreu um erro inesperado"
         Subtitle="Não foi possível concluir o processamento da sua solicitação."
         Border="AppCardBorder.Danger">
    <HeaderContent>
        <AppBadge Variant="AppBadgeVariant.Danger" Text="Erro interno" Dot="true" />
    </HeaderContent>
    <ChildContent>
        @if (ShowRequestId)
        {
            <p>
                <strong>Código da requisição:</strong> <code>@RequestId</code>
            </p>
        }
        <p>Tente recarregar a página ou retornar para o painel operacional.</p>
    </ChildContent>
    <FooterContent>
        <AppButton Href="/" Variant="AppButtonVariant.Primary">Voltar para o início</AppButton>
    </FooterContent>
</AppCard>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
