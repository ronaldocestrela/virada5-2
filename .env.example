# Exemplo de variáveis de ambiente (Regra 1.8 agents.md)
# Copie este arquivo para .env e preencha os valores localmente (nunca faça commit do .env)

DB_CONNECTION_STRING="Server=localhost,1433;Database=Scale5x2Db;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;"
MSSQL_SA_PASSWORD="CHANGE_ME"
ASPNETCORE_ENVIRONMENT="Development"

# Persistência de chaves DataProtection (obrigatório em produção para cookies e links compartilhados)
DATA_PROTECTION_KEYS_PATH=""
# Aplicar migrations EF Core no startup apenas em container único local ("true" no Docker Compose, "false" em App Service)
RUN_MIGRATIONS_ON_STARTUP="false"

# Telemetria Estruturada (OpenTelemetry + Serilog)
OTEL_SERVICE_NAME="Virada5x2.WebApp"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
SERILOG_MINIMUM_LEVEL="Information"
SERILOG_LOG_FILE_PATH=""

# URL pública base para links de conversão e QR Codes do Ebook (GTM)
PUBLIC_APP_BASE_URL="https://app.virada5x2.com.br"
